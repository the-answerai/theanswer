#!/bin/sh
# Theme Validation Pre-commit Hook
# Validates theme configuration and pattern compliance before commit

. "$(dirname "$0")/_/husky.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🎨 Theme Validation${NC}"

# Check if theme files were modified
THEME_FILES=$(git diff --cached --name-only | grep -E 'packages-answers/ui/src/theme/' || true)

if [ -z "$THEME_FILES" ]; then
    echo "${GREEN}✓ No theme files modified${NC}"
    exit 0
fi

echo "${YELLOW}Theme files detected:${NC}"
echo "$THEME_FILES" | sed 's/^/  /'

# Run theme compliance check
echo ""
echo "${BLUE}Running theme compliance validation...${NC}"

# Check if theme validators exist
if [ ! -f "packages-answers/ui/src/theme/validators/themeCompliance.ts" ]; then
    echo "${YELLOW}⚠ Theme compliance validator not found${NC}"
    echo "  Create with: pnpm run theme:validate:setup"
    exit 0
fi

# Check theme configuration
echo ""
echo "${BLUE}Validating theme structure...${NC}"

# Verify glassmorphism tokens exist
if ! grep -q "glassmorphismTokens" "packages-answers/ui/src/theme/tokens/glassmorphism.ts" 2>/dev/null; then
    echo "${RED}✗ Glassmorphism tokens not found${NC}"
    exit 1
fi

echo "${GREEN}✓ Glassmorphism tokens found${NC}"

# Verify color tokens exist
if ! grep -q "colorTokens" "packages-answers/ui/src/theme/tokens/colors.ts" 2>/dev/null; then
    echo "${RED}✗ Color tokens not found${NC}"
    exit 1
fi

echo "${GREEN}✓ Color tokens found${NC}"

# Check for direct palette access in modified files
echo ""
echo "${BLUE}Checking for deprecated patterns in modified files...${NC}"

DEPRECATED_PATTERNS=0

# Check for direct theme.palette access (except in validators)
PALETTE_VIOLATIONS=$(git diff --cached "$THEME_FILES" | grep -E '^\+.*theme\.palette\.' | grep -v 'validators' | grep -v '//.*theme\.palette' || true)

if [ -n "$PALETTE_VIOLATIONS" ]; then
    echo "${YELLOW}⚠ Possible theme.palette direct access detected:${NC}"
    echo "$PALETTE_VIOLATIONS" | sed 's/^/  /'
    DEPRECATED_PATTERNS=$((DEPRECATED_PATTERNS + 1))
fi

# Check for theme.palette.common access
COMMON_VIOLATIONS=$(git diff --cached "$THEME_FILES" | grep -E '^\+.*theme\.palette\.common' || true)

if [ -n "$COMMON_VIOLATIONS" ]; then
    echo "${YELLOW}⚠ theme.palette.common access detected (deprecated):${NC}"
    echo "$COMMON_VIOLATIONS" | sed 's/^/  /'
    DEPRECATED_PATTERNS=$((DEPRECATED_PATTERNS + 1))
fi

if [ $DEPRECATED_PATTERNS -eq 0 ]; then
    echo "${GREEN}✓ No deprecated patterns detected${NC}"
fi

# Final status
echo ""
echo "${BLUE}Theme validation complete${NC}"

# Exit with success (warnings are non-blocking)
exit 0
