{
  "version": "1.0",
  "project": {
    "name": "TheAnswer",
    "description": "Enterprise AI workflow platform built on Flowise with advanced multi-tenancy, authentication, and integration capabilities",
    "repository": "https://github.com/the-answerai/theanswer",
    "license": "Proprietary (SEE LICENSE IN LICENSE.md)",
    "nodeVersion": ">=18.15.0 <19.0.0 || ^20",
    "pnpmVersion": ">=9",
    "projectType": "Monorepo - Web App + Backend API + Components Library"
  },
  "core_frameworks": [
    {
      "name": "React",
      "package": "react",
      "version": "18.2.0",
