        "Main UI component library across web app and Flowise UI",
        "Server and Client Components in Next.js",
        "Interactive dashboards and flow editor"
      ],
      "key_modules": [
        "react/jsx-runtime",
        "react-dom",
        "react-dom/client"
      ]
    },
    {
      "name": "Next.js",
      "package": "next",
      "version": "^14.2.32",
      "installed_version": "14.2.32",
      "type": "framework",
      "purpose": "React-based full-stack framework with App Router, server/client components, and built-in API routes",
      "documentation": "https://nextjs.org/docs",
      "github": "https://github.com/vercel/next.js",
      "usage": [
        "Main web application (apps/web)",
