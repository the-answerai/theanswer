        },
        {
          "name": "LANGFUSE_SECRET_KEY",
          "description": "Secret key for Langfuse integration",
          "required": false
        },
        {
          "name": "LANGFUSE_HOST",
          "description": "Langfuse host URL (default: cloud.langfuse.com)",
          "required": false
        }
      ],
      "endpoints_available": [
        "POST /api/public/traces - Log traces",
        "POST /api/public/observations - Log observations",
