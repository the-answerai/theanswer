      "github": "https://github.com/expressjs/express",
      "usage": [
        "Core REST API server (packages/server)",
        "Route handling and middleware pipeline",
        "Error handling and response formatting",
        "Authentication and authorization middleware"
      ],
      "key_modules": [
        "express/Router",
        "express-session",
        "express-rate-limit"
      ]
    },
    {
      "name": "TypeScript",
      "package": "typescript",
      "version": "~5.5.4",
      "installed_version": "5.5.4",
