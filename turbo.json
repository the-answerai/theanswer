    "tasks": {
        "//#dev-docker": {
            "cache": false
        },
        "//#dev-inngest": {
            "cache": false
        },
        "//#dev-langchain": {
            "cache": false
        },
        "//#db:healthcheck": {
            "cache": false
        },
        "//#db:studio": {
            "cache": false
        },
        "flowise-components:build": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", ".next/**"]
        },
        "flowise-components:dev": {
            "cache": false
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", ".next/**"]
        },
        "test:auth": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", ".next/**"]
        },
        "db:generate": {
            "dependsOn": ["db:deploy"],
            "outputs": ["dist/**", "generated/**"]
        },
        "db:migrate": {
            "cache": false,
            "dependsOn": [],
            "outputs": []
        },
        "db:deploy": {
            "cache": false,
            "dependsOn": [],
            "outputs": ["dist/**"]
        },
        "db#build": {
            "cache": false,
            "outputs": ["dist/**", "generated/**"]
        },
        "db#dev": {
            "dependsOn": ["//#db:healthcheck", "build"],
            "cache": false,
            "outputs": ["dist/**"]
        },
        "web#build": {
            "dependsOn": ["^build", "db#build"],
            "outputs": ["dist/**", ".next/**"]
        },
        "lint": {
            "outputs": []
        },
        "start": {
            "dependsOn": ["^build", "build"],
            "outputs": ["dist/**", ".next/**"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test": {},
        "typeorm:migration-run": {
            "cache": false
        },
        "typeorm:migration-generate": {
            "cache": false
        },
        "typeorm:migration-show": {
            "cache": false
        }
    }
