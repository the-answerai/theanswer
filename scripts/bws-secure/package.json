{
  "name": "bws-secure",
  "version": "1.0.0-scripts/bws-secure",
  "description": "Secure environment management with Bitwarden Secrets Manager",
  "type": "module",
  "scripts": {
    "start": "node secureRun.js",
    "upload": "node secureRun.js --upload-secrets",
    "list": "node list-projects.js",
    "scan": "node check-vars/requiredRuntimeVars.js",
    "test:bws-env": "node --test tests/bws-env-utils.test.mjs",
    "test:e2e": "node --test tests/e2e/secureRun.e2e.test.mjs",
    "test": "node --test tests/bws-env-utils.test.mjs tests/e2e/secureRun.e2e.test.mjs"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "glob": "^13.0.6",
    "yargs": "^18.0.0"
  }
}
